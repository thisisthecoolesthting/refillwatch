---
import ArticleToC from '@/components/ArticleToC.astro';
import CaseAdSlot from '@/components/CaseAdSlot.astro';
---

<aside
  class="article-sidebar-rail hidden lg:block w-52 xl:w-56 shrink-0"
  aria-label="Page map and sponsors"
>
  <div class="article-sidebar-sticky">
    <section class="article-sidebar-toc" aria-labelledby="article-page-map-heading">
      <ArticleToC embedded />
    </section>

    <div class="article-sidebar-ad not-prose">
      <CaseAdSlot size="728x90" placement="longform-sidebar-sticky" />
    </div>
  </div>
</aside>

<style>
  /* Sticky rail: page map on top, phone-case leaderboard under — both stay in view while reading */
  .article-sidebar-sticky {
    position: sticky;
    top: 5rem;
    z-index: 10;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: calc(100vh - 5.5rem);
  }

  .article-sidebar-toc {
    flex: 0 1 auto;
    min-height: 0;
    max-height: min(42vh, 22rem);
    overflow: hidden;
  }

  .article-sidebar-toc :global(#article-toc) {
    display: flex;
    flex-direction: column;
    max-height: min(42vh, 22rem);
  }

  .article-sidebar-toc :global(.toc-list-scroll) {
    max-height: min(36vh, 18rem);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .article-sidebar-ad {
    flex: 0 0 auto;
  }

  .article-sidebar-ad :global(.cad-wrap) {
    margin: 0;
  }

  .article-sidebar-ad :global(.cad-leader-inner) {
    flex-wrap: wrap;
    padding: 8px 10px;
  }

  .article-sidebar-ad :global(.cad-leader-img) {
    width: 40px;
    height: 52px;
  }
</style>
