---
import CaseAdSlot from '@/components/CaseAdSlot.astro';
import ArticleToC from '@/components/ArticleToC.astro';
---

<aside
  class="article-sidebar-rail hidden xl:flex flex-col gap-3 w-44 shrink-0 sticky top-24 self-start"
  aria-label="Article navigation"
>
  <ArticleToC embedded />
  <div class="article-sidebar-ad not-prose">
    <CaseAdSlot size="320x50" placement="article-sidebar" />
  </div>
</aside>

<style>
  .article-sidebar-rail {
    max-height: calc(100vh - 7rem);
  }
  .article-sidebar-ad :global(.cad-wrap) {
    margin: 0;
  }
  /* Compact banner for narrow rail — do not use 160×600 skyscraper here */
  .article-sidebar-ad :global(.cad-leader-inner) {
    flex-direction: column;
    align-items: stretch;
    height: auto;
    min-height: 0;
    padding: 8px;
    gap: 6px;
  }
  .article-sidebar-ad :global(.cad-leader-accent-bar) {
    display: none;
  }
  .article-sidebar-ad :global(.cad-leader-img) {
    width: 100%;
    height: 52px;
    max-height: 52px;
    object-fit: cover;
    border-radius: 6px;
  }
  .article-sidebar-ad :global(.cad-leader-body) {
    width: 100%;
  }
  .article-sidebar-ad :global(.cad-leader-name) {
    font-size: 11px;
    white-space: normal;
    line-height: 1.25;
  }
  .article-sidebar-ad :global(.cad-leader-tag) {
    display: none;
  }
  .article-sidebar-ad :global(.cad-leader-offer) {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 4px 6px;
    margin: 0;
  }
  .article-sidebar-ad :global(.cad-leader-pct) {
    font-size: 10px;
  }
  .article-sidebar-ad :global(.cad-leader-code) {
    font-size: 9px;
  }
  .article-sidebar-ad :global(.cad-leader-cta) {
    display: block;
    width: 100%;
    text-align: center;
    font-size: 10px;
    padding: 6px 8px;
    margin-top: 2px;
  }
</style>
