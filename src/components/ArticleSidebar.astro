---
import ArticleToC from '@/components/ArticleToC.astro';
import PhoneCaseFamilyTextLinks from '@/components/PhoneCaseFamilyTextLinks.astro';
---

<aside
  class="article-sidebar-rail hidden xl:block w-52 shrink-0 self-start"
  aria-label="Article navigation"
>
  <div class="article-sidebar-sticky">
    <ArticleToC embedded />
    <div class="mt-4">
      <PhoneCaseFamilyTextLinks placement="article-sidebar" compact />
    </div>
  </div>
</aside>

<style>
  /* TOC scrolls inside sticky box — avoids whole-rail lock/fight with page scroll */
  .article-sidebar-sticky {
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 7rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-right: 2px;
  }
</style>
