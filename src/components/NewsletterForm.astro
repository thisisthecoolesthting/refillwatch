---
// Reusable newsletter signup — posts to Ricky's shared subscribe endpoint via
// rcc-events.js (form[data-rcc-subscribe]). No embed/iframe dependency.
export interface Props {
  variant?: 'hero' | 'inline' | 'footer';
  title?: string;
  subtitle?: string;
  cta?: string;
}

const {
  variant = 'hero',
  title = 'Get shrinkflation alerts',
  subtitle = 'Price hikes, hidden shrink and cheaper refills — weekly. No spam.',
  cta = 'Alert me',
} = Astro.props;

const site = 'refillwatch.org';
---

{variant === 'hero' && (
  <div class="text-center">
    <p class="text-terracotta-600 text-xs uppercase tracking-[0.2em] font-semibold mb-4">
      The RefillWatch weekly
    </p>
    <h2 class="font-display text-3xl md:text-4xl text-ink-900 mb-4">{title}</h2>

    <form
      data-rcc-subscribe
      data-rcc-site={site}
      class="flex flex-col sm:flex-row max-w-md mx-auto gap-3"
    >
      <label class="sr-only" for="rcc-email-hero">Email address</label>
      <input id="rcc-email-hero" type="email" name="email" required autocomplete="email" placeholder="you@email.com" class="input-soft flex-1" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <button type="submit" class="btn-primary">{cta}</button>
    </form>
    <p class="text-sm text-ink-500 mt-3">{subtitle}</p>
  </div>
)}

{variant === 'inline' && (
  <aside class="my-10 p-6 md:p-8 bg-cream-100 rounded-[2rem] shadow-soft not-prose relative overflow-hidden">
    <span aria-hidden="true" class="absolute left-0 top-6 bottom-6 w-1.5 rounded-r-full bg-terracotta-500"></span>
    <p class="text-terracotta-600 text-xs uppercase tracking-[0.18em] font-semibold mb-2">
      Stay in the loop
    </p>
    <h3 class="font-display text-xl text-ink-900 !mt-0 mb-2">{title}</h3>

    <form
      data-rcc-subscribe
      data-rcc-site={site}
      class="flex flex-col sm:flex-row gap-3"
    >
      <label class="sr-only" for="rcc-email-inline">Email address</label>
      <input id="rcc-email-inline" type="email" name="email" required autocomplete="email" placeholder="you@email.com" class="input-soft flex-1 text-sm py-2.5" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <button type="submit" class="btn-primary text-sm px-6 py-2.5">{cta}</button>
    </form>
    <p class="text-ink-700 text-sm mt-4 leading-relaxed">{subtitle}</p>
  </aside>
)}

{variant === 'footer' && (
  <div>
    <h3 class="font-display text-base text-ink-900 !mt-0 mb-2">{title}</h3>

    <form
      data-rcc-subscribe
      data-rcc-site={site}
      class="flex gap-2"
    >
      <label class="sr-only" for="rcc-email-footer">Email address</label>
      <input id="rcc-email-footer" type="email" name="email" required autocomplete="email" placeholder="you@email.com"
             class="flex-1 min-w-0 px-3 py-2 rounded-full border border-cream-200 bg-white text-xs
                    focus:outline-none focus:ring-2 focus:ring-terracotta-400 focus:border-transparent" />
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <button type="submit" class="btn-primary text-xs px-4 py-2">{cta}</button>
    </form>
    <p class="text-xs text-ink-700 mt-3">{subtitle}</p>
  </div>
)}
