---
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import AffiliateDisclosure from '@/components/AffiliateDisclosure.astro';
import home from '@/data/brand.config.json';

const id = home.brand.identity;
const siteBrandName = home.brand.fullName;

export interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  noindex?: boolean;
  // Open Graph type controls Pinterest Rich Pin detection.
  //   'website' — home, about, listings (default)
  //   'article' — pillars, articles; unlocks Article Rich Pins
  //   'product' — product reviews (Product Rich Pins detected via JSON-LD already)
  ogType?: 'website' | 'article' | 'product';
  // Required-by-Pinterest when ogType='article'
  articlePublishedTime?: string;    // ISO8601
  articleModifiedTime?: string;     // ISO8601
  articleAuthor?: string;           // free text
  articleSection?: string;          // e.g. 'Hot Flashes', 'Sleep'
  articleTags?: string[];
}

const {
  title,
  description = home.brand.taglineShort,
  image = '/og-default.png',
  canonical,
  noindex = false,
  ogType = 'website',
  articlePublishedTime,
  articleModifiedTime,
  articleAuthor = siteBrandName,
  articleSection,
  articleTags = [],
} = Astro.props;

const siteUrl = 'https://refillwatch.org';
const fullTitle = title.includes(siteBrandName) ? title : `${title} | ${siteBrandName}`;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {id.fontCssHref ? <link rel="stylesheet" href={id.fontCssHref} /> : null}

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, siteUrl).toString()} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content={siteBrandName} />

    {ogType === 'article' && (
      <>
        {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
        {articleModifiedTime  && <meta property="article:modified_time"  content={articleModifiedTime} />}
        <meta property="article:author" content={articleAuthor} />
        {articleSection && <meta property="article:section" content={articleSection} />}
        {articleTags.map((t) => <meta property="article:tag" content={t} />)}
      </>
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL(image, siteUrl).toString()} />

    <link rel="alternate" type="application/rss+xml" title={siteBrandName} href="/rss.xml" />

    {/* Beehiiv embed auto-resize script. Loads once per page regardless of how
        many NewsletterForm instances are embedded. No-op if env var isn't set. */}
    {(() => {
      const url = import.meta.env.PUBLIC_NEWSLETTER_EMBED_URL;
      if (typeof url === 'string' && url.includes('subscribe-forms.beehiiv.com')) {
        return <script async src="https://subscribe-forms.beehiiv.com/embed.js"></script>;
      }
      return null;
    })()}
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <AffiliateDisclosure />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
  