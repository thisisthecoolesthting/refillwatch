---
import CompliantLayout from '@/layouts/CompliantLayout.astro';
import NewsletterForm from '@/components/NewsletterForm.astro';
import FeaturedProductsBlock from '@/components/FeaturedProductsBlock.astro';
import AuthorByline from '@/components/AuthorByline.astro';
import { getCollection, getEntry } from 'astro:content';
import { getRelatedProductsFromBody } from '@/utils/related-products';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => data.status !== 'draft');
  return articles.map((a) => ({
    params: { slug: a.slug },
    props: { entry: a },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const authorSlug = entry.data.author ?? 'dana-wolff';
const author = await getEntry('authors', authorSlug);

const relatedProducts = await getRelatedProductsFromBody(entry.body);

const publishedISO = new Date(entry.data.publishedAt).toISOString();
const modifiedISO  = entry.data.updatedAt ? new Date(entry.data.updatedAt).toISOString() : undefined;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.metaDescription,
  datePublished: publishedISO,
  dateModified: modifiedISO ?? publishedISO,
  author: author ? {
    '@type': 'Person',
    '@id': `https://refillwatch.org/authors/${author.slug}/#person`,
    name: author.data.name,
    url: `https://refillwatch.org/authors/${author.slug}/`,
    image: `https://refillwatch.org${author.data.photoUrl}`,
    jobTitle: author.data.role,
  } : { '@type': 'Organization', name: 'RefillWatch', url: 'https://refillwatch.org' },
  publisher:{ '@type': 'Organization', name: 'RefillWatch', url: 'https://refillwatch.org' },
  image: entry.data.heroImage ? [entry.data.heroImage] : undefined,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://refillwatch.org/articles/${entry.slug}/`,
  },
};
---

<CompliantLayout
  title={entry.data.title}
  description={entry.data.metaDescription}
  image={entry.data.heroImage}
  ogType="article"
  articleJsonLd={articleSchema}
  articlePublishedTime={publishedISO}
  articleModifiedTime={modifiedISO}
  articleAuthor={author?.data.name ?? 'RefillWatch'}
  articleTags={entry.data.tags}
>
  <article class="container-prose py-12 md:py-16 pb-28 md:pb-20">
    <header class="mb-6">
      <h1 class="font-display text-3xl md:text-4xl text-ink-900 mb-3 !mt-0">{entry.data.title}</h1>
    </header>

    <AuthorByline
      authorSlug={authorSlug}
      publishedAt={entry.data.publishedAt}
      reviewedAt={entry.data.reviewedAt ?? entry.data.updatedAt}
    />

    {entry.data.heroImage && (
      <figure class="mb-10 -mx-4 md:mx-0">
        <img
          src={entry.data.heroImage}
          alt={entry.data.title}
          loading="eager"
          class="w-full h-auto rounded-3xl object-cover aspect-[16/9] max-h-[480px] shadow-soft"
        />
      </figure>
    )}

    <div class="prose prose-lg prose-ink max-w-none">
      <Content />
    </div>

    <FeaturedProductsBlock products={relatedProducts} />

    <NewsletterForm
      variant="inline"
      title="The RefillWatch Alert"
      subtitle="One price hike we caught and one refill alternative that beats it, once a week."
    />
  </article>

</CompliantLayout>
