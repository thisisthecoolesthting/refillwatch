---
import CompliantLayout from '@/layouts/CompliantLayout.astro';
import SiteSectionAds from '@/components/SiteSectionAds.astro';
import ProductCard from '@/components/ProductCard.astro';
import { getCollection } from 'astro:content';

const products = await getCollection('products', ({ data }) => data.status === 'published');
const sorted = products.sort((a, b) => (b.data.score ?? 0) - (a.data.score ?? 0));

const byCategory = sorted.reduce<Record<string, typeof sorted>>((acc, p) => {
  const cat = p.data.category || 'other';
  (acc[cat] = acc[cat] || []).push(p);
  return acc;
}, {});
---

<CompliantLayout
  title="Product reviews"
  description="RefillWatch tracks household staples, bulk refills, and repeat buys — scored by price history and real-world value."
>
  <SiteSectionAds page="reviews" variant="header" />
  <section class="max-w-site mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="max-w-3xl mx-auto text-center mb-10">
      <h1 class="font-display text-4xl text-ink-900 mb-4">Product reviews</h1>
      <p class="text-ink-700">
        Sorted by our internal score: sales velocity, review quality, and category value so the
        top rows are picks we would actually restock.
      </p>
    </div>

    {Object.entries(byCategory).map(([cat, items]) => (
      <section class="mb-14">
        <h2 class="font-display text-2xl text-ink-900 capitalize mb-5">{cat.replace(/-/g, ' ')}</h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-5">
          {items.map((p) => <ProductCard product={p} />)}
        </div>
      </section>
    ))}
  </section>
  <SiteSectionAds page="reviews" variant="footer" />
</CompliantLayout>
